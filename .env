# ==========================================================

# ⚙️ TRAIDBOLT - CONFIGURAÇÃO GERAL

# ==========================================================

# Nome da exchange principal (ex: binance, solana, bsc)

EXCHANGE=binance

# Par de trade (padrão BTC/USDT)

TRADE_SYMBOL=BTC/USDT

# Intervalo de candles (1m, 5m, 15m, 1h)

TIMEFRAME=1m

# Quantidade da operação (em unidade do token base)

TRADE_AMOUNT=0.001

# Percentuais de Stop-Loss e Take-Profit

STOP_LOSS_PCT=0.5         # -0.5%
TAKE_PROFIT_PCT=1.0        # +1.0%

# Intervalo entre loops de verificação (segundos)

SLEEP_TIME=20

# Habilitar modo de teste (true/false)

TESTNET=true

# ==========================================================

# 🔑 API BINANCE

# ==========================================================

BINANCE_API_KEY=SUACHAVE_TESTNET_AQUI
BINANCE_API_SECRET=SEUSECRET_TESTNET_AQUI

# ==========================================================

# 🪙 CARTEIRAS BLOCKCHAIN

# ==========================================================

# Binance Smart Chain (para futuros módulos BEP-20)

BSC_PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_AQUI
BSC_RPC=[https://bsc-dataseed.binance.org/](https://bsc-dataseed.binance.org/)

# Solana (chave privada ou seed exportada da Phantom)

SOLANA_PRIVATE_KEY=aqU6z8xVyWHtZaVp5thEAPa2sFw9hUjyCfJiWxnP9xt6ujypWJ
SOLANA_RPC=[https://api.mainnet-beta.solana.com](https://api.mainnet-beta.solana.com)

# ==========================================================

# 💬 TELEGRAM BOT (alertas e status)

# ==========================================================

TELEGRAM_TOKEN=7855112245:AAFmgU3djjbZL7hH8BtQ7wIZ6QUFL77wwvI
TELEGRAM_CHAT_ID=6781369857

# ==========================================================

# 📊 AJUSTES OPCIONAIS

# ==========================================================

# Valor fixo em USD por trade (usado se não quiser TRADE_AMOUNT)

ORDER_SIZE_USD=10

# Percentuais alternativos (compatibilidade com bots antigos)

SL_PERCENT=0.98
TP_PERCENT=1.02
POLL_INTERVAL=5

