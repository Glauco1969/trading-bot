# ======================
# ⚙️ Configuração Geral
# ======================
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1m
ORDER_SIZE_USD=10
SL_PERCENT=0.98
TP_PERCENT=1.02
POLL_INTERVAL=5
TESTNET=true

# ======================
# 🔑 API Binance
# ======================
API_KEY=COLOQUE_SUA_BINANCE_API_KEY_AQUI
API_SECRET=COLOQUE_SUA_BINANCE_API_SECRET_AQUI
BINANCE_API_KEY=COLOQUE_SUA_BINANCE_API_KEY_AQUI
BINANCE_API_SECRET=COLOQUE_SUA_BINANCE_API_SECRET_AQUI

# ======================
# 🪙 Carteiras Blockchain
# ======================
BSC_PRIVATE_KEY=COLOQUE_SUA_CHAVE_PRIVADA_BSC_AQUI
SOLANA_PRIVATE_KEY=COLOQUE_SUA_CHAVE_PRIVADA_SOLANA_AQUI
# ou use um caminho para keypair
# SOLANA_KEYPAIR_PATH=./wallet/keypair.json

# ======================
# 💬 Telegram
# ======================
TELEGRAM_TOKEN=SEU_TOKEN_TELEGRAM
TELEGRAM_CHAT_ID=@SeuCanalOuID

# ======================
# 🌐 RPC Endpoints
# ======================
BSC_RPC=https://bsc-dataseed.binance.org/
SOLANA_RPC=https://api.mainnet-beta.solana.com
